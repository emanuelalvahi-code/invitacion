<body class="bg-wedding-cream text-wedding-charcoal font-sans antialiased selection:bg-wedding-sage selection:text-white overflow-x-hidden">

    <!-- ELEMENTO DE AUDIO PERSONALIZADO -->
    <audio id="bg-audio" loop="" preload="auto" src="bd.mp3"></audio>

    <!-- PANTALLA DE BIENVENIDA (SOBRE INTERACTIVO) -->
    <div id="envelope-overlay" class="fixed inset-0 z-50 flex flex-col items-center justify-center bg-wedding-sand transition-opacity duration-1000 px-4" style="">
        <div class="max-w-md w-full bg-wedding-cream border border-wedding-gold/40 rounded-3xl p-8 sm:p-10 text-center shadow-2xl relative overflow-hidden">
            <!-- Detalle floral SVG decorativo -->
            <svg class="w-16 h-16 mx-auto text-wedding-sage mb-4 opacity-80" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="1.2">
                <path d="M32 54C32 54 32 24 32 10M32 42C24 42 18 36 18 28C26 28 32 34 32 42ZM32 34C40 34 46 28 46 20C38 20 32 26 32 34ZM32 24C25 24 20 19 20 12C27 12 32 17 32 24Z" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
            
            <p class="text-xs uppercase tracking-[0.25em] text-wedding-muted mb-2">Estás invitado a la boda de</p>
            <h2 id="envelope-names" class="font-script text-4xl sm:text-5xl text-wedding-charcoal my-3">Eva y Emanuel </h2>
            <p id="envelope-date" class="font-serif italic text-lg text-wedding-muted mb-8">14 de Diciembre, 2026</p>
            
            <button onclick="openInvitation()" class="w-full py-3.5 px-6 bg-wedding-sage hover:bg-wedding-sageDark text-white rounded-full text-xs uppercase tracking-[0.2em] font-medium transition-all duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-0.5 flex items-center justify-center gap-2">
                <span>Abrir Invitación</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 19v-8.93a2 2 0 01.89-1.664l7-4.666a2 2 0 012.22 0l7 4.666A2 2 0 0121 10.07V19M3 19a2 2 0 002 2h14a2 2 0 002-2M3 19l6.75-4.5M21 19l-6.75-4.5M3 10l6.75 4.5M21 10l-6.75 4.5m0 0l-1.14.76a2 2 0 01-2.22 0l-1.14-.76"></path></svg>
            </button>
        </div>
    </div>

    <!-- BOTONES FLOTANTES (MÚSICA Y EDITOR) -->
    <div class="fixed bottom-5 right-5 z-40 flex flex-col gap-3 items-end">
        <!-- Botón de Música (se muestra solo si hay una canción configurada) -->
        <button id="music-toggle-btn" onclick="toggleMusic()" title="Reproducir / Pausar Música" class="w-12 h-12 rounded-full bg-white/90 backdrop-blur-md border border-wedding-gold/40 text-wedding-charcoal shadow-lg flex items-center justify-center hover:scale-105 transition-transform">
            <svg id="music-icon-off" class="w-5 h-5 text-wedding-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"></path></svg>
            <svg id="music-icon-on" class="w-5 h-5 text-wedding-sage hidden animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"></path></svg>
        </button>

        <!-- Botón Abrir Editor -->
        <button id="open-editor-btn" onclick="toggleEditor()" class="px-4 py-3 rounded-full bg-wedding-charcoal text-white shadow-xl flex items-center gap-2 hover:bg-black transition-all hover:scale-105 text-xs font-medium tracking-wider uppercase" style="display: none;">
            <svg class="w-4 h-4 text-wedding-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            <span>Editar Datos</span>
        </button>
    </div>

    <!-- CONTENEDOR PRINCIPAL DE LA INVITACIÓN -->
    <main class="max-w-3xl mx-auto bg-white shadow-2xl min-h-screen relative overflow-hidden">
        
        <!-- 1. PORTADA / HERO SECTION -->
        <section class="relative min-h-[90vh] flex flex-col justify-between items-center text-center px-6 py-16 bg-wedding-sand/40">
            <div class="absolute inset-0 z-0">
                <img id="display-hero-img" src="https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&amp;fit=crop&amp;w=1200&amp;q=80" onerror="this.src='https://placehold.co/1200x1600/F0EBE1/5B6B5B?text=Foto+de+Portada'" alt="Portada Boda" class="w-full h-full object-cover opacity-35">
                <div class="absolute inset-0 bg-gradient-to-b from-wedding-cream/80 via-wedding-cream/40 to-wedding-cream"></div>
            </div>

            <div class="relative z-10 mt-6">
                <p class="text-xs sm:text-sm uppercase tracking-[0.3em] text-wedding-muted font-medium">¡Nos Casamos!</p>
            </div>

            <div class="relative z-10 my-auto py-8">
                <h1 id="display-couple-names" class="font-script text-6xl sm:text-8xl text-wedding-charcoal leading-tight drop-shadow-sm">Eva y Emanuel </h1>
                <div class="flex items-center justify-center gap-4 my-6">
                    <span class="h-[1px] w-12 bg-wedding-gold"></span>
                    <p id="display-hero-date" class="font-serif text-xl sm:text-2xl tracking-widest uppercase text-wedding-charcoal">14 . 12 . 2026</p>
                    <span class="h-[1px] w-12 bg-wedding-gold"></span>
                </div>
                <p id="display-hero-city" class="text-xs uppercase tracking-[0.25em] text-wedding-muted">Atizapán de Zaragoza Estado de México </p>
            </div>

            <div class="relative z-10 animate-float">
                <a href="#frase-section" class="inline-flex flex-col items-center text-wedding-muted hover:text-wedding-charcoal transition-colors">
                    <span class="text-[10px] uppercase tracking-[0.2em] mb-2">Desliza</span>
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg>
                </a>
            </div>
        </section>

        <!-- 2. FRASE -->
        <section id="frase-section" class="py-16 px-6 sm:px-12 text-center bg-wedding-cream fade-in-section is-visible">
            <svg class="w-10 h-10 mx-auto text-wedding-gold mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
            
            <blockquote id="display-quote" class="font-serif italic text-2xl sm:text-3xl text-wedding-charcoal max-w-xl mx-auto leading-relaxed">"El amor no consiste en mirarse el uno al otro, sino en mirar juntos en la misma dirección." — Antoine de Saint-Exupéry</blockquote>
        </section>

        <!-- 3. CUENTA REGRESIVA (COUNTDOWN) -->
        <section class="py-16 px-6 bg-wedding-sage text-white text-center fade-in-section">
            <p class="text-xs uppercase tracking-[0.25em] text-white/80 mb-2">Falta muy poco para el gran día</p>
            <h2 class="font-serif text-3xl sm:text-4xl mb-8">Cuenta Regresiva</h2>
            
            <div class="grid grid-cols-4 gap-3 sm:gap-6 max-w-lg mx-auto">
                <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-4 border border-white/20">
                    <span id="cd-days" class="block font-serif text-3xl sm:text-5xl font-semibold">24</span>
                    <span class="text-[10px] sm:text-xs uppercase tracking-widest text-white/80 mt-1 block">Días</span>
                </div>
                <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-4 border border-white/20">
                    <span id="cd-hours" class="block font-serif text-3xl sm:text-5xl font-semibold">16</span>
                    <span class="text-[10px] sm:text-xs uppercase tracking-widest text-white/80 mt-1 block">Horas</span>
                </div>
                <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-4 border border-white/20">
                    <span id="cd-minutes" class="block font-serif text-3xl sm:text-5xl font-semibold">05</span>
                    <span class="text-[10px] sm:text-xs uppercase tracking-widest text-white/80 mt-1 block">Min</span>
                </div>
                <div class="bg-white/10 backdrop-blur-sm rounded-2xl p-4 border border-white/20">
                    <span id="cd-seconds" class="block font-serif text-3xl sm:text-5xl font-semibold">44</span>
                    <span class="text-[10px] sm:text-xs uppercase tracking-widest text-white/80 mt-1 block">Seg</span>
                </div>
            </div>
