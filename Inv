                    <textarea id="manual-copy-textarea" rows="3" readonly="" onclick="this.select()" class="w-full p-2 text-[10px] font-mono bg-white border rounded-lg text-gray-700 focus:outline-none"></textarea>
                </div>
            </div>
        </div>
    </div>

    <!-- TOAST DE NOTIFICACIÓN PERSONALIZADO -->
    <div id="toast-msg" class="fixed top-5 left-1/2 transform -translate-x-1/2 z-50 bg-wedding-charcoal text-white px-6 py-3 rounded-full shadow-xl text-xs tracking-wider uppercase transition-all duration-300 pointer-events-none opacity-0">¡Datos guardados correctamente!</div>

    <!-- CONFIGURACIÓN DE DATOS EN JSON SEGURO -->
    <script id="wedding-config-data" type="application/json">
    {
    "names": "Eva y Emanuel ",
    "datetime": "2026-12-14T14:00",
    "dateText": "14 . 12 . 2026",
    "envelopeDate": "14 de Diciembre, 2026",
    "city": "Atizapán de Zaragoza Estado de México ",
    "hashtag": "#Eva&Ema2026",
    "musicUrl": "bd.mp3",
    "quote": "\"El amor no consiste en mirarse el uno al otro, sino en mirar juntos en la misma dirección.\" — Antoine de Saint-Exupéry",
    "ceremonyTime": "14:00 HRS",
    "ceremonyPlace": "Nuestro Hogar ",
    "ceremonyAddress": " Calle Olmos #12 colonia las Peñitas Atizapán de Zaragoza Estado de México",
    "ceremonyMap": "https://maps.app.goo.gl/nfBrvuZeHui59ocy8",
    "receptionTime": "18:30 HRS",
    "receptionPlace": "Nuestro Hogar ",
    "receptionAddress": "Calle Olmos #12 colonia las Peñitas Atizapán de Zaragoza Estado de México",
    "receptionMap": "https://maps.app.goo.gl/nfBrvuZeHui59ocy8",
    "whatsapp": "525614845616",
    "heroImg": "https://images.unsplash.com/photo-1519741497674-611481863552?auto=format&fit=crop&w=1200&q=80",
    "gal1": "https://github.com/emanuelalvahi-code/FOTOS/blob/main/1777590651282_edit_358553851164.jpg",
    "gal2": "https://github.com/emanuelalvahi-code/FOTOS/blob/main/1795132642678.jpg",
    "gal3": "https://github.com/emanuelalvahi-code/FOTOS/blob/main/IMG-20170526-WA0004.jpg",
    "gal4": "https://github.com/emanuelalvahi-code/FOTOS/blob/main/1795134189502.jpg",
    "gal5": "https://images.unsplash.com/photo-1529636798458-92182e662485?auto=format&fit=crop&w=600&q=80",
    "isExported": true
}
    </script>

    <script>
        // ==========================================
        // 1. ESTADO Y CONFIGURACIÓN
        // ==========================================
        function getEmbeddedConfig() {
            try {
                const scriptTag = document.getElementById('wedding-config-data');
                return JSON.parse(scriptTag.textContent);
            } catch (e) {
                return {};
            }
        }

        const defaultData = getEmbeddedConfig();
        let weddingData = { ...defaultData };

        function loadSavedData() {
            // Si el archivo ya fue exportado como versión final, prioriza sus datos incrustados
            if (!defaultData.isExported) {
                try {
                    const saved = localStorage.getItem('wedding_invitation_data_v3');
                    if (saved) {
                        weddingData = { ...defaultData, ...JSON.parse(saved), isExported: false };
                    }
                } catch (e) {
                    console.warn("No se pudo acceder a localStorage", e);
                }
            } else {
                // Ocultar botón de edición en el archivo final para los invitados
                const editorBtn = document.getElementById('open-editor-btn');
                if (editorBtn) editorBtn.style.display = 'none';
            }
            populateEditorInputs();
            renderInvitation();
        }

        function populateEditorInputs() {
            document.getElementById('edit-names').value = weddingData.names || "";
            document.getElementById('edit-datetime').value = weddingData.datetime || "";
            document.getElementById('edit-date-text').value = weddingData.dateText || "";
            document.getElementById('edit-envelope-date').value = weddingData.envelopeDate || "";
            document.getElementById('edit-city').value = weddingData.city || "";
            document.getElementById('edit-hashtag').value = weddingData.hashtag || "";
            document.getElementById('edit-music-url').value = weddingData.musicUrl || "";
            document.getElementById('edit-quote').value = weddingData.quote || "";
            document.getElementById('edit-ceremony-time').value = weddingData.ceremonyTime || "";
            document.getElementById('edit-ceremony-place').value = weddingData.ceremonyPlace || "";
            document.getElementById('edit-ceremony-address').value = weddingData.ceremonyAddress || "";
            document.getElementById('edit-ceremony-map').value = weddingData.ceremonyMap || "";
            document.getElementById('edit-reception-time').value = weddingData.receptionTime || "";
            document.getElementById('edit-reception-place').value = weddingData.receptionPlace || "";
            document.getElementById('edit-reception-address').value = weddingData.receptionAddress || "";
            document.getElementById('edit-reception-map').value = weddingData.receptionMap || "";
            document.getElementById('edit-whatsapp').value = weddingData.whatsapp || "";
            document.getElementById('edit-hero-img').value = weddingData.heroImg || "";
            document.getElementById('edit-gal-1').value = weddingData.gal1 || "";
            document.getElementById('edit-gal-2').value = weddingData.gal2 || "";
            document.getElementById('edit-gal-3').value = weddingData.gal3 || "";
            document.getElementById('edit-gal-4').value = weddingData.gal4 || "";
            document.getElementById('edit-gal-5').value = weddingData.gal5 || "";
        }

        function renderInvitation() {
            document.title = `Boda de ${weddingData.names} - Invitación Digital`;
            document.getElementById('envelope-names').textContent = weddingData.names;
            document.getElementById('envelope-date').textContent = weddingData.envelopeDate;
            document.getElementById('display-couple-names').textContent = weddingData.names;
            document.getElementById('display-footer-names').textContent = weddingData.names;
            document.getElementById('display-hero-date').textContent = weddingData.dateText;
            document.getElementById('display-hero-city').textContent = weddingData.city;
            document.getElementById('display-hashtag').textContent = weddingData.hashtag;
            document.getElementById('display-quote').textContent = weddingData.quote;

            // Configurar Audio Personalizado
            const audioEl = document.getElementById('bg-audio');
            const musicBtn = document.getElementById('music-toggle-btn');
            const cleanMusicUrl = (weddingData.musicUrl || "").trim();
            
            if (cleanMusicUrl) {
                if (audioEl.getAttribute('src') !== cleanMusicUrl) {
                    audioEl.setAttribute('src', cleanMusicUrl);
                }
                musicBtn.classList.remove('hidden');
            } else {
                audioEl.pause();
                audioEl.removeAttribute('src');
                musicBtn.classList.add('hidden');
                isPlayingMusic = false;
                updateMusicUI();
            }

            // Ubicaciones
            document.getElementById('display-ceremony-time').textContent = weddingData.ceremonyTime;
            document.getElementById('display-ceremony-place').textContent = weddingData.ceremonyPlace;
            document.getElementById('display-ceremony-address').textContent = weddingData.ceremonyAddress;
            document.getElementById('display-ceremony-map').href = weddingData.ceremonyMap || '#';

            document.getElementById('display-reception-time').textContent = weddingData.receptionTime;
            document.getElementById('display-reception-place').textContent = weddingData.receptionPlace;
            document.getElementById('display-reception-address').textContent = weddingData.receptionAddress;
            document.getElementById('display-reception-map').href = weddingData.receptionMap || '#';

            // Imágenes (Portada + 5 Fotos Collage)
            if(weddingData.heroImg) document.getElementById('display-hero-img').src = weddingData.heroImg;
            if(weddingData.gal1) document.getElementById('display-gal-1').src = weddingData.gal1;
            if(weddingData.gal2) document.getElementById('display-gal-2').src = weddingData.gal2;
            if(weddingData.gal3) document.getElementById('display-gal-3').src = weddingData.gal3;
            if(weddingData.gal4) document.getElementById('display-gal-4').src = weddingData.gal4;
            if(weddingData.gal5) document.getElementById('display-gal-5').src = weddingData.gal5;
        }

        function updateLive() {
            weddingData.names = document.getElementById('edit-names').value;
            weddingData.datetime = document.getElementById('edit-datetime').value;
            weddingData.dateText = document.getElementById('edit-date-text').value;
            weddingData.envelopeDate = document.getElementById('edit-envelope-date').value;
            weddingData.city = document.getElementById('edit-city').value;
            weddingData.hashtag = document.getElementById('edit-hashtag').value;
            weddingData.musicUrl = document.getElementById('edit-music-url').value;
            weddingData.quote = document.getElementById('edit-quote').value;
            weddingData.ceremonyTime = document.getElementById('edit-ceremony-time').value;
            weddingData.ceremonyPlace = document.getElementById('edit-ceremony-place').value;
            weddingData.ceremonyAddress = document.getElementById('edit-ceremony-address').value;
            weddingData.ceremonyMap = document.getElementById('edit-ceremony-map').value;
            weddingData.receptionTime = document.getElementById('edit-reception-time').value;
            weddingData.receptionPlace = document.getElementById('edit-reception-place').value;
            weddingData.receptionAddress = document.getElementById('edit-reception-address').value;
            weddingData.receptionMap = document.getElementById('edit-reception-map').value;
            weddingData.whatsapp = document.getElementById('edit-whatsapp').value;
            weddingData.heroImg = document.getElementById('edit-hero-img').value;
            weddingData.gal1 = document.getElementById('edit-gal-1').value;
            weddingData.gal2 = document.getElementById('edit-gal-2').value;
            weddingData.gal3 = document.getElementById('edit-gal-3').value;
            weddingData.gal4 = document.getElementById('edit-gal-4').value;
            weddingData.gal5 = document.getElementById('edit-gal-5').value;

            try {
                localStorage.setItem('wedding_invitation_data_v3', JSON.stringify(weddingData));
            } catch (e) {}

            renderInvitation();
            updateCountdown();
        }

        // ==========================================
        // 2. REPRODUCTOR DE AUDIO PERSONALIZADO
        // ==========================================
        let isPlayingMusic = false;

        function playCustomMusic() {
            const audioEl = document.getElementById('bg-audio');
            const cleanMusicUrl = (weddingData.musicUrl || "").trim();
            if (!cleanMusicUrl) return;

            audioEl.play().then(() => {
                isPlayingMusic = true;
                updateMusicUI();
            }).catch(e => {
                console.warn("No se pudo reproducir el audio automáticamente:", e);
                isPlayingMusic = false;
                updateMusicUI();
            });
        }

        function toggleMusic() {
            const audioEl = document.getElementById('bg-audio');
            if (!isPlayingMusic) {
                playCustomMusic();
            } else {
                audioEl.pause();
                isPlayingMusic = false;
                updateMusicUI();
            }
        }

        function updateMusicUI() {
            const iconOff = document.getElementById('music-icon-off');
            const iconOn = document.getElementById('music-icon-on');
            if (isPlayingMusic) {
                iconOff.classList.add('hidden');
                iconOn.classList.remove('hidden');
            } else {
                iconOff.classList.remove('hidden');
                iconOn.classList.add('hidden');
            }
        }

        // ==========================================
        // 3. INTERACCIONES UI, SOBRE Y CUENTA REGRESIVA
        // ==========================================
        function openInvitation() {
            const overlay = document.getElementById('envelope-overlay');
            overlay.classList.add('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                overlay.style.display = 'none';
            }, 1000);
            playCustomMusic();
        }

        function toggleEditor() {
            const drawer = document.getElementById('editor-drawer');
            drawer.classList.toggle('hidden');
        }

        function showToast(text) {
            const toast = document.getElementById('toast-msg');
            toast.textContent = text;
            toast.classList.remove('opacity-0');
            setTimeout(() => {
                toast.classList.add('opacity-0');
            }, 3000);
        }

        function saveAndClose() {
            updateLive();
            toggleEditor();
            showToast("¡Datos guardados correctamente!");
        }

        function resetDefaults() {
            try {
                localStorage.removeItem('wedding_invitation_data_v3');
            } catch (e) {}
            location.reload();
        }

        function buildFinalHTMLString() {
            updateLive();
            const docClone = document.documentElement.cloneNode(true);

            // 1. Inyectar los datos actuales marcados como exportados dentro del JSON
            const configScript = docClone.querySelector('#wedding-config-data');
            const exportPayload = { ...weddingData, isExported: true };
            configScript.textContent = "\n    " + JSON.stringify(exportPayload, null, 4) + "\n    ";

            // 2. Asegurar que el sobre de bienvenida inicie visible y cerrado
            const overlay = docClone.querySelector('#envelope-overlay');
            overlay.classList.remove('opacity-0', 'pointer-events-none');
            overlay.style.display = '';

            // 3. Asegurar que el panel de edición esté cerrado y el botón oculto
            const drawer = docClone.querySelector('#editor-drawer');
            drawer.classList.add('hidden');
            const editorBtn = docClone.querySelector('#open-editor-btn');
            if (editorBtn) editorBtn.style.display = 'none';
            const copyBox = docClone.querySelector('#manual-copy-box');
            if (copyBox) copyBox.classList.add('hidden');

            return "<!DOCTYPE html>\n" + docClone.outerHTML;
        }

        function copyFinalHTML() {
            const htmlContent = buildFinalHTMLString();
            const manualBox = document.getElementById('manual-copy-box');
            const manualTextarea = document.getElementById('manual-copy-textarea');
            
            manualTextarea.value = htmlContent;
            manualBox.classList.remove('hidden');
            manualTextarea.select();
            manualTextarea.setSelectionRange(0, 999999);

            try {
                const successful = document.execCommand('copy');
                if (successful) {
                    showToast("¡Código copiado! Pégalo en tu archivo index.html");
                } else {
                    showToast("Selecciona el cuadro de abajo y presiona Ctrl+C / Copiar");
                }
            } catch (err) {
                showToast("Selecciona el cuadro de abajo y presiona Ctrl+C / Copiar");
            }
        }

        function exportHTML() {
            const htmlContent = buildFinalHTMLString();
            try {
                const blob = new Blob([htmlContent], { type: "text/html;charset=utf-8" });
                const url = URL.createObjectURL(blob);
                const a = document.createElement("a");
                a.href = url;
                a.download = "index.html";
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
                showToast("Intentando descargar index.html...");
            } catch (e) {
                copyFinalHTML();
            }
        }

        function updateCountdown() {
            const targetDate = new Date(weddingData.datetime).getTime();
            const now = new Date().getTime();
            const diff = targetDate - now;

            if (isNaN(targetDate) || diff <= 0) {
                document.getElementById('cd-days').textContent = "00";
                document.getElementById('cd-hours').textContent = "00";
                document.getElementById('cd-minutes').textContent = "00";
                document.getElementById('cd-seconds').textContent = "00";
                return;
            }

            const days = Math.floor(diff / (1000 * 60 * 60 * 24));
            const hours = Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((diff % (1000 * 60)) / 1000);

            document.getElementById('cd-days').textContent = String(days).padStart(2, '0');
            document.getElementById('cd-hours').textContent = String(hours).padStart(2, '0');
            document.getElementById('cd-minutes').textContent = String(minutes).padStart(2, '0');
            document.getElementById('cd-seconds').textContent = String(seconds).padStart(2, '0');
        }

        function handleRSVP(e) {
            e.preventDefault();
            const name = document.getElementById('rsvp-name').value;
            const attending = document.getElementById('rsvp-attending').value;
            const guests = document.getElementById('rsvp-guests').value;
            const msg = document.getElementById('rsvp-message').value;

            const text = `¡Hola! Soy *${name}*.\nConfirmo mi asistencia a la boda de *${weddingData.names}*:\n• Estado: ${attending}\n• Pases: ${guests}\n• Mensaje: ${msg || '¡Muchas felicidades!'}`;
            const phone = (weddingData.whatsapp || "").replace(/\D/g, '');
            const waUrl = `https://wa.me/${phone}?text=${encodeURIComponent(text)}`;
            
            showToast("Abriendo WhatsApp para enviar confirmación...");
            window.open(waUrl, '_blank', 'noopener,noreferrer');
        }

        function setupScrollAnimations() {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.classList.add('is-visible');
                    }
                });
            }, { threshold: 0.1 });

            document.querySelectorAll('.fade-in-section').forEach(sec => observer.observe(sec));
        }

        window.addEventListener('DOMContentLoaded', () => {
            loadSavedData();
            updateCountdown();
            setInterval(updateCountdown, 1000);
            setupScrollAnimations();
        });
    </script>

